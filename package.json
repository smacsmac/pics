{
  "name": "photon",
  "version": "0.1.0",
  "private": true,
  "description": "Galerie photo locale, sombre et néon, pilotable à la manette.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "seed": "tsx scripts/seed-demo.ts",
    "test:vision": "tsx scripts/test-vision.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "all-the-cities": "^3.1.0",
    "better-sqlite3": "^12.4.1",
    "exifr": "^7.1.3",
    "fastify": "^5.6.1",
    "ffmpeg-static": "^5.2.0",
    "heic-convert": "^2.1.0",
    "i18n-iso-countries": "^7.14.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
